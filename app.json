{
  "expo": {
    "name": "WeGrow B School",
    "slug": "wegrow-b-school",
    "version": "1.0.5",
    "scheme": "wegrow",
    "orientation": "portrait",
    "icon": "./assets/logo/logo_square.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo/logo_square.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wegrowworkshop.wegrowskillcampus"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo/logo_adaptive_foreground.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.wegrowworkshop.wegrowskillcampus"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo/logo_square.png",
          "backgroundColor": "#ffffff",
          "imageWidth": 200
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          },
          "ios": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ]
  }
}
