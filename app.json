{
  "expo": {
    "name": "WeGrow Skill Campus",
    "slug": "wegrow-skill-campus",
    "version": "1.0.4",
    "scheme": "wegrow",
    "orientation": "portrait",
    "icon": "./assets/logo/logo_header.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo/logo_header.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo/logo_header.png",
        "backgroundColor": "#ffffff"
      },
      "usesCleartextTraffic": true
    },
    "plugins": ["expo-router"]
  }
}
