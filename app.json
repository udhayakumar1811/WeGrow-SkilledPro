{
  "expo": {
    "name": "WeGrow B School",
    "slug": "wegrow-skill-campus",
    "version": "1.0.5",
    "scheme": "wegrow",
    "orientation": "portrait",
    "icon": "./assets/logo/logo_square.png",
    "userInterfaceStyle": "light",

    "splash": {
      "image": "./assets/logo/logo_square.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },

    "ios": {
      "supportsTablet": true
    },

    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo/logo_adaptive_foreground.png",
        "backgroundColor": "#ffffff"
      },
      "usesCleartextTraffic": true,
      "package": "com.wegrowworkshop.wegrowskillcampus"
    },

    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo/logo_square.png",
          "backgroundColor": "#ffffff",
          "imageWidth": 200
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],

    "extra": {
      "router": {},
      "eas": {
        "projectId": "d0aafb5b-8bd1-4128-953a-3980768a3139"
      }
    }
  }
}
